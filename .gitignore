node_modules/
dist/
target/
# La base y todo lo que derive de ella: respaldos (dev.db.respaldo-…) y los
# temporales de SQLite (-journal, -wal, -shm). El patrón lleva el asterisco
# final porque «*.db» no alcanzaba y los respaldos —con jugadas, clientes y
# plata del local adentro— se estaban por subir al repo.
*.db*
.env
apps/desktop/src-tauri/target/
# Las imágenes promocionales del pie de la pizarra. Son material del local
# —avisos de patrocinantes— cargado desde Configuración, no código: viven
# con la base, se respaldan con ella y no tienen por qué viajar en el repo.
apps/backend/datos/

# El backend ya empaquetado para el instalador. Lo arma
# apps/backend/scripts/empaquetar.js y NO se versiona: lleva el runtime de
# Node y el motor de Prisma, que son binarios propios de cada sistema
# operativo — el de Linux no arranca en Windows.
apps/desktop/src-tauri/recursos/
