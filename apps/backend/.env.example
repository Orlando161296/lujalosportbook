DATABASE_URL="file:./dev.db"

# --- Impresora térmica ---
# La impresora YA NO se configura acá: se elige en Configuración › Impresora y
# queda guardada en la carpeta de datos de la PC (impresora.json). Instalada
# como programa no hay .env que editar ni servidor que reiniciar.
#
# Estas variables siguen sirviendo en desarrollo como valor inicial, mientras
# no se haya elegido nada en la pantalla. En cuanto se guarda desde la app,
# manda el archivo.
#
#   IMPRESORA_DESTINO=log|usb|red
#   IMPRESORA_ANCHO_MM=58|80
#   IMPRESORA_RUTA=/dev/ticketera        (Windows: \\localhost\TICKETERA)
#   IMPRESORA_HOST=192.168.1.50
#   IMPRESORA_PUERTO=9100

# --- Carpeta de datos ---
# Base, avisos de la pizarra y configuración de la impresora. Instalada, la
# app le pasa el AppData del usuario; en desarrollo es <cwd>/datos.
# LUJALO_DATOS_DIR=/var/lujalo

# Sólo los avisos, si hicieran falta en otro disco.
# Por defecto: <carpeta de datos>/promociones
# PROMOCIONES_DIR=/var/lujalo/promociones
