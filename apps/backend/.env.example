DATABASE_URL="file:./dev.db"

# --- Impresora térmica ---
# Sin nada de esto el ticket sale por el log del backend y el remate igual
# puede cobrar: es el modo con el que se trabaja mientras no haya térmica.
#
# destino:  log | usb | red
#   log — al log, sin papel (desarrollo, o impresora desenchufada)
#   usb — a un dispositivo o a una impresora compartida (ver IMPRESORA_RUTA)
#   red — a una impresora Ethernet por el puerto RAW 9100
IMPRESORA_DESTINO=log

# 58 (la que hay hoy en el local) u 80. Decide el ancho del ticket:
# 58 mm = 32 columnas, 80 mm = 48 columnas. Ante la duda, 58: un ticket
# angosto entra en papel ancho, al revés se cortan los montos.
IMPRESORA_ANCHO_MM=58

# destino=usb — a dónde se escriben los bytes:
#   Linux   /dev/usb/lp0   (o /dev/ttyUSB0 si entra por adaptador serie)
#   Windows \\localhost\TICKETERA   (compartir la impresora con ese nombre)
# IMPRESORA_RUTA=/dev/usb/lp0

# destino=red
# IMPRESORA_HOST=192.168.1.50
# IMPRESORA_PUERTO=9100

# ¿Tiene guillotina? Las 58 mm de gama baja no: se corta a mano y hacen falta
# las líneas de avance para que el pie del ticket pase la barra dentada.
# Por defecto: false en 58 mm, true en 80 mm.
# IMPRESORA_CORTA=false
# IMPRESORA_AVANCE=4
# IMPRESORA_TIMEOUT_MS=5000
